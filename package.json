{
  "name": "react-vite-ts-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "npm run lint:oxlint && npm run lint:biome",
    "lint:oxlint": "oxlint --type-aware --deny-warnings",
    "lint:biome": "biome check .",
    "lint:fix": "oxlint --type-aware --fix && biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "crap": "vitest run --coverage --coverage.reporter=json && fallow health --complexity --coverage coverage/coverage-final.json --max-crap 6",
    "fallow": "npm run fallow:dead-code && npm run fallow:architecture && npm run fallow:dupes && npm run fallow:css",
    "fallow:dead-code": "fallow dead-code",
    "fallow:architecture": "fallow architecture",
    "fallow:dupes": "fallow dupes",
    "fallow:css": "fallow health --css",
    "e2e": "playwright test",
    "mutation": "stryker run",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run crap && npm run fallow && npm run build && npm run e2e && npm run mutation",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.14.0",
    "eslint-plugin-no-comment-slop": "0.6.0",
    "fallow": "3.33.1",
    "jsdom": "30.1.2",
    "lefthook": "2.2.1",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
